{
  "name": "roofingcrm",
  "private": true,
  "version": "0.1.0",
  "description": "Single-user desktop CRM for roofing operations.",
  "author": "dazium",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc -b && vite build",
    "android:sync": "cap sync android",
    "verify": "npm run lint && npm run test && npm run build && npm run android:sync",
    "clean:release": "node -e \"require('fs').rmSync('release',{recursive:true,force:true})\"",
    "android:debug": "scripts\\android-debug.cmd",
    "android:release": "scripts\\android-release.cmd",
    "desktop:attach": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:4173 electron .",
    "desktop:dev": "concurrently --success first \"npm run dev:desktop\" \"wait-on tcp:127.0.0.1:4173 && npm run desktop:attach\"",
    "desktop:dev:attach": "wait-on tcp:127.0.0.1:4173 && npm run desktop:attach",
    "desktop:build": "npm run build && npm run clean:release && electron-builder --win nsis --publish never",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.25.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "cliui": "^8.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "puppeteer": "^23.0.0",
    "sqlite3": "^5.1.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.4",
    "y18n": "^5.0.8",
    "yargs": "^17.7.2",
    "yargs-parser": "^21.1.1"
  },
  "build": {
    "appId": "com.daziu.roofingcrm.desktop",
    "productName": "Munro & Sons Roofing Experts",
    "artifactName": "${productName} Setup ${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Munro & Sons Roofing Experts",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "warningsAsErrors": false,
      "include": "build/installer.nsh"
    }
  }
}
